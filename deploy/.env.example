# TYBooks 部署环境变量
# 复制此文件为 .env 并替换所有 <YOUR_*> 占位符

# PostgreSQL 应用用户密码
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>

# PostgreSQL 复制用户密码（多节点部署时需要）
REPLICATOR_PASSWORD=<YOUR_REPLICATOR_PASSWORD>

# Primary 节点内网 IP（Standby 节点上填写，Primary 节点留空）
PRIMARY_IP=<YOUR_PRIMARY_IP>

# Standby 节点内网 IP（逗号分隔，支持多个，Primary 节点上填写）
# 示例: 10.0.0.2,10.0.0.3
STANDBY_IPS=<YOUR_STANDBY_IPS>

# JWT 密钥（所有节点必须一致）
JWT_SECRET=<YOUR_JWT_SECRET>

# TYBooks 部署环境变量
# 复制此文件为 .env 并替换所有 <YOUR_*> 占位符

# PostgreSQL 主库密码
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>

# PostgreSQL 复制用户密码
REPLICATOR_PASSWORD=<YOUR_REPLICATOR_PASSWORD>

# 服务器A 内网 IP
SERVER_A_IP=<YOUR_SERVER_A_IP>

# 服务器B 内网 IP
SERVER_B_IP=<YOUR_SERVER_B_IP>

# JWT 密钥（两台服务器必须一致）
JWT_SECRET=<YOUR_JWT_SECRET>

# deploy-podman 的运维目标描述，由 scripts/ops/*.sh 读取。
# 与 deploy-docker 的差异只体现在这里：运行时是 podman，
# 容器由 pod 创建，配置是 pod.yaml（无变量插值，用 <YOUR_*> 占位符）。

# 运行时命令：docker 或 podman
RUNTIME=podman

# 容器名（podman play kube 按 Pod 名 + 容器名生成）
APP_CONTAINER=tybooks-app
PG_CONTAINER=tybooks-postgres

# 应用端口
APP_PORT=8080

# 需要检查占位符残留的文件及其正则
CONFIG_FILE=pod.yaml
PLACEHOLDER_PATTERN='<YOUR_[A-Z_]+>'

# 声明镜像的文件（用于 doctor 的架构检查）
MANIFEST_FILE=pod.yaml

# 备份用的库名和用户
PG_USER=tybooks
PG_DB=tybooks

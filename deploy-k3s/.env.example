# TYBooks K3s 部署环境变量模板
# 复制为 .env 并替换占位符；该文件仅用于手工执行部署命令，不会被应用读取

# PostgreSQL 应用用户密码（仅使用字母和数字，避免 URL 转义问题）
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# JWT 签名密钥（用 openssl rand -base64 32 生成，不要提交到仓库）
JWT_SECRET=YOUR_JWT_SECRET

# 对外域名（与 Nginx server_name、DNS A 记录保持一致）
DOMAIN=YOUR_DOMAIN

# App Service 的 NodePort（与 app/app.yaml 保持一致）
NODE_PORT=30080

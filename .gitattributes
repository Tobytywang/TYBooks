# 统一用 LF：Windows 上若检出成 CRLF，脚本会报
# "/bin/bash^M: bad interpreter: No such file or directory"
*.sh    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.env   text eol=lf
.env*   text eol=lf

# 二进制产物不做行尾转换
*.tar    binary
*.tar.gz binary
*.png    binary
*.jpg    binary
*.gz     binary

# deploy-docker 的运维目标描述，由 scripts/ops/*.sh 读取。
# 加一个新的部署方式时，复制这个文件到新目录并调整即可。

# 运行时命令：docker 或 podman
RUNTIME=docker

# 容器名（docker compose 的 project + service + 序号）
APP_CONTAINER=primary-app-1
PG_CONTAINER=primary-postgres-1

# 应用端口
APP_PORT=8080

# 需要检查占位符残留的文件及其正则
CONFIG_FILE=.env
PLACEHOLDER_PATTERN='<YOUR_[A-Z_]+>'

# 声明镜像的文件（用于 doctor 的架构检查）
MANIFEST_FILE=primary/docker-compose.yml

# 备份用的库名和用户
PG_USER=tybooks
PG_DB=tybooks

{
  "name": "tybooks",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "version:bump": "node scripts/version/bump.mjs",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "docker:build": "ENGINE=docker bash scripts/image/build.sh",
    "podman:build": "ENGINE=podman bash scripts/image/build.sh",
    "image:export": "bash scripts/image/export.sh",
    "image:verify": "bash scripts/image/verify-tars.sh",
    "ops:doctor": "bash scripts/ops/doctor.sh",
    "ops:verify": "bash scripts/ops/verify.sh",
    "ops:password": "bash scripts/ops/set-password.sh",
    "ops:backup": "bash scripts/ops/backup.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
